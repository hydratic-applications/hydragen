  },
  {
    "id": "help-init",
    "mode": "captured",
    "args": [
      "init",
      "--help"
    ],
    "directory": "/audit/help-init",
    "exit": 0,
    "stdout": "Initialise a layer in the current directory\n\nUsage: hydragen init [OPTIONS]\n\nOptions:\n      --name <NAME>                Optional name override (defaults to the current directory name; must not be blank)\n      --non-interactive            Never prompt, even in a terminal\n      --author <AUTHOR>            Optional person or organisation credited with authoring the layer\n      --description <DESCRIPTION>  Optional explanation of what the layer provides or is used for\n  -h, --help                       Print help\n\nExamples:\n  hydragen init\n  hydragen init --name shared-agent-rules\n  hydragen init --name shared-agent-rules --author \"Example team\" --description \"Shared coding-agent instructions.\"\n  hydragen init --non-interactive --name shared-agent-rules\n\nNo metadata flags: guided prompts when stdin, stdout and stderr are terminals and CI is disabled.\nAny metadata flag: flag-only input; no follow-up questions.\nName defaults to the current directory name when omitted. Author and description are optional.\n--non-interactive always disables prompts.\n",
    "stderr": "",
    "manifest": null
  },
